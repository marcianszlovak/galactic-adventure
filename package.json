{
  "name": "galactic-spacefarer",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.19.0",
    "@cap-js/sqlite": "^3",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-spacefarers": "cds watch --open spacefarers/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {
    "requires": {
      "auth": {
        "kind": "mocked",
        "users": {
          "marci": {
            "password": "marci",
            "roles": [
              "SpacefarerAdmin"
            ],
            "attr": {
              "planet": "Mars"
            }
          },
          "peter": {
            "password": "peter",
            "roles": [
              "SpacefarerViewer"
            ],
            "attr": {
              "planet": "Planet Y"
            }
          },
          "john": {
            "password": "romero",
            "roles": [
              "SpacefarerOfficer"
            ],
            "attr": {
              "planet": "Planet X"
            }
          },
          "american": {
            "password": "mcghee",
            "roles": [
              "SpacefarerOfficer"
            ],
            "attr": {
              "planet": "Venus"
            }
          },
          "*": false
        }
      },
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/spacefarers",
    "app/spacefarers"
  ]
}
